#!/usr/bin/env bash
#
# tc - jump to a tmux pane running a cursor-agent or waitingFor session.
#
# Like `tmux choose-tree`, but the list is filtered down to only the panes
# whose process tree contains a running `cursor-agent` or `waitingFor`
# process. Selecting an entry switches the current tmux client straight
# to that pane.
#
# Every row starts with an icon and a state, followed by the pane's location
# and details. cursor-agent panes reuse the state cursor-agent already renders
# in its pane title (working/ready); waitingFor panes stay `waiting` while the
# script is still polling and only flip to `ready` once it has finished and is
# sitting at its "Further prompt" prompt.
#
# Usage:
#   tc                    interactive picker (fzf), jumps to the chosen pane
#   tc -l                 just list matching panes, don't prompt/jump
#   tc --preview-loop ID  (internal) live-refresh preview for fzf, see below

# fzf's --preview command is executed via $SHELL, which may be fish/zsh/etc,
# so it can't rely on bash-only syntax (e.g. `while ... done`). To get a
# live-updating preview (like `tmux choose-tree`) regardless of the user's
# shell, fzf just re-invokes this script in a hidden mode that does the
# refresh loop natively in bash.
if [ "$1" = "--preview-loop" ]; then
    pane_id="$2"
    prev=""
    while tmux has-session -t "$pane_id" 2>/dev/null; do
        curr=$(tmux capture-pane -p -e -t "$pane_id")
        if [ "$curr" != "$prev" ]; then
            # fzf's preview window only reliably redraws on CSI 2J (full
            # clear); plain cursor-addressing (CSI H) + erase-to-end (CSI J)
            # isn't honored the same way a real terminal would, so it just
            # looked frozen. Only pay the clear-and-redraw cost when the
            # frame actually changed, to cut down on unnecessary flicker.
            printf '\033[2J\033[H'
            printf '%s\n' "$curr"
            prev="$curr"
        fi
        sleep 1
    done
    exit 0
fi

which tmux >/dev/null 2>&1 || { echo "tc: tmux not found" >&2; exit 1; }
which fzf  >/dev/null 2>&1 || { echo "tc: fzf not found"  >&2; exit 1; }

tmux info >/dev/null 2>&1 || { echo "tc: no tmux server running" >&2; exit 1; }

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

list_only=0
[ "$1" = "-l" ] && list_only=1

panes=$(tmux list-panes -a -F "#{pane_id}	#{session_name}:#{window_index}.#{pane_index}	#{window_name}	#{pane_pid}	#{pane_title}	#{pane_current_path}")
[ -z "$panes" ] && { echo "tc: no tmux panes found" >&2; exit 1; }

pane_pids=$(echo "$panes" | cut -f4 | tr '\n' ' ')

# Take a single ps snapshot and, for each pane's root pid, walk its process
# tree (via ppid) looking for a running `cursor-agent` or `waitingFor`
# process. Doing this as one awk pass (rather than N recursive pgrep/ps
# calls) is both faster and more reliable - pgrep -P has been observed to
# miss children in some sandboxed shells even though `ps` sees them fine.
# Emits "rootpid=kind" pairs; a pane running both counts as waitingFor, since
# that's the process whose state the caller wants to see.
agent_pids=$(ps -axo pid=,ppid=,command= | awk -v ROOTS="$pane_pids" '
    BEGIN { n = split(ROOTS, roots, " ") }
    {
        pid = $1 + 0; ppid = $2 + 0
        $1 = ""; $2 = ""
        cmd = $0
        sub(/^ +/, "", cmd)
        command[pid] = cmd
        children[ppid] = children[ppid] " " pid
    }
    END {
        for (i = 1; i <= n; i++) {
            root = roots[i] + 0
            delete visited
            qlen = 1; queue[1] = root
            agent = 0; waiting = 0
            while (qlen > 0) {
                cur = queue[qlen]; qlen--
                if (visited[cur]++) continue
                if (index(command[cur], "waitingFor") > 0) waiting = 1
                else if (index(command[cur], "cursor-agent") > 0) agent = 1
                nkids = split(children[cur], kids, " ")
                for (k = 1; k <= nkids; k++) {
                    if (kids[k] != "") { qlen++; queue[qlen] = kids[k] }
                }
            }
            if (waiting) printf "%s=waitingFor ", root
            else if (agent) printf "%s=cursor-agent ", root
        }
    }
')

[ -z "$agent_pids" ] && { echo "tc: no panes running cursor-agent or waitingFor" >&2; exit 1; }

# pane_id \t kind \t "session:window.pane [window-name]" \t pane-title \t pane-path
matches=$(echo "$panes" | awk -F'\t' -v AGENTS="$agent_pids" '
    BEGIN {
        n = split(AGENTS, a, " ")
        for (i = 1; i <= n; i++) {
            split(a[i], kv, "=")
            kind[kv[1]] = kv[2]
        }
    }
    ($4 in kind) { printf "%s\t%s\t%s [%s]\t%s\t%s\n", $1, kind[$4], $2, $3, $5, $6 }
')

[ -z "$matches" ] && { echo "tc: no panes running cursor-agent or waitingFor" >&2; exit 1; }

# Lead every row with "<icon> <state>". cursor-agent maintains its own state in
# the pane title as "<chat title> - <icon> <state>", so that just gets hoisted
# to the front. waitingFor polls silently, so the only reliable signal that it
# is done is the interactive prompt it prints after READY - the status file it
# also writes is a single global path, shared by every pane.
matches=$(
    while IFS=$'\t' read -r pane_id kind label title path; do
        icon="🤖" state="running"
        if [ "$kind" = "waitingFor" ]; then
            if tmux capture-pane -p -t "$pane_id" 2>/dev/null |
                tail -n 5 |
                grep -q 'Further prompt (Enter to exit)'; then
                icon="✅" state="ready"
            else
                icon="⏳" state="waiting"
            fi
        elif [ "$title" != "${title% - *}" ]; then
            suffix="${title##* - }"
            title="${title% - *}"
            icon="${suffix%% *}"
            # The title's state is animated ("Working ···"), so trim the
            # trailing dots to stop rows jittering between refreshes.
            state=$(printf '%s' "${suffix#* }" |
                sed -E 's/[[:space:]]*[.·•…]+[[:space:]]*$//' |
                tr '[:upper:]' '[:lower:]')
            if [ -z "$state" ] || [ "$state" = "$icon" ]; then
                state="running"
            fi
        fi
        printf '%s\t%s %-8s %s\t%s\t%s\n' \
            "$pane_id" "$icon" "$state" "$label" "$title" "$path"
    done <<<"$matches"
)

if [ "$list_only" = "1" ]; then
    echo "$matches" | cut -f2-
    exit 0
fi

selected=$(echo "$matches" | fzf \
    --delimiter=$'\t' \
    --with-nth=2,3 \
    --reverse \
    --header="cursor-agent / waitingFor sessions >" \
    --preview "\"$self\" --preview-loop {1}" \
    --preview-window=bottom:60%)

[ -z "$selected" ] && exit 1

pane_id=$(echo "$selected" | cut -f1)

if [ -z "$TMUX" ]; then
    tmux attach-session -t "$pane_id"
else
    tmux switch-client -t "$pane_id"
    tmux select-window -t "$pane_id"
    tmux select-pane -t "$pane_id"
fi
