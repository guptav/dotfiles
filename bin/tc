#!/usr/bin/env bash
#
# tc - jump to a tmux pane running a cursor-agent or waitingFor session.
#
# Like `tmux choose-tree`, but the list is filtered down to only the panes
# whose process tree contains a running `cursor-agent` or `waitingFor`
# process. Selecting an entry switches the current tmux client straight
# to that pane.
#
# Every row starts with an icon and a state, followed by the pane's location
# and details. cursor-agent panes reuse the state cursor-agent already renders
# in its pane title (working/ready); waitingFor panes stay `waiting` while the
# script is still polling and only flip to `ready` once it has finished and is
# sitting at its "Further prompt" prompt.
#
# Usage:
#   tc                    interactive picker (fzf), jumps to the chosen pane
#   tc -l                 just list matching panes, don't prompt/jump
#   tc --preview-loop ID  (internal) live-refresh preview for fzf, see below

# fzf's --preview command is executed via $SHELL, which may be fish/zsh/etc,
# so it can't rely on bash-only syntax (e.g. `while ... done`). To get a
# live-updating preview (like `tmux choose-tree`) regardless of the user's
# shell, fzf just re-invokes this script in a hidden mode that does the
# refresh loop natively in bash.
if [ "$1" = "--preview-loop" ]; then
    pane_id="$2"
    prev=""
    while tmux has-session -t "$pane_id" 2>/dev/null; do
        curr=$(tmux capture-pane -p -e -t "$pane_id")
        if [ "$curr" != "$prev" ]; then
            # fzf's preview window only reliably redraws on CSI 2J (full
            # clear); plain cursor-addressing (CSI H) + erase-to-end (CSI J)
            # isn't honored the same way a real terminal would, so it just
            # looked frozen. Only pay the clear-and-redraw cost when the
            # frame actually changed, to cut down on unnecessary flicker.
            printf '\033[2J\033[H'
            printf '%s\n' "$curr"
            prev="$curr"
        fi
        sleep 1
    done
    exit 0
fi

if [ "$1" = "--task-office" ]; then
    task project:office
    exit $?
fi

if [ "$1" = "--task-preview" ]; then
    task_id="$2"
    printf '$ task %s\n\n' "$task_id"
    task "$task_id"
    exit 0
fi

if [ "$1" = "--add-task-office" ]; then
    printf 'Task description: '
    IFS= read -r task_description || exit 1
    [ -n "$task_description" ] || exit 1
    task add project:office "$task_description"
    exit $?
fi

if [ "$1" = "--open-waiting" ]; then
    urls="${2:-}"
    for url in $urls; do
        url="${url#\"}"
        url="${url%\"}"
        case "$url" in
            http://*|https://*) open "$url" ;;
        esac
    done
    exit 0
fi

if [ "$1" = "--open-task" ]; then
    task "$2" |
        grep -Eo 'https?://[^[:space:]]+' |
        sed -E 's/[),.;]+$//' |
        while IFS= read -r url; do
            open "$url"
        done
    exit 0
fi

if [ "$1" = "--open-entry" ]; then
    case "$2" in
        __task_office_*__)
            task_id="${2#__task_office_}"
            task_id="${task_id%__}"
            exec "$0" --open-task "$task_id"
            ;;
    esac
    exec "$0" --open-waiting "${3:-}"
fi

if [ "$1" = "--open-task-pane" ]; then
    task_id="$2"
    window_name="task-$task_id"
    if [ -n "${TMUX:-}" ]; then
        session="$(tmux display-message -p '#{client_last_session}')"
        target="$session:$window_name"
        if tmux has-session -t "$target" 2>/dev/null; then
            tmux switch-client -t "$target"
        else
            new_target="$(tmux new-window -t "$session:" -n "$window_name" \
                -c "$PWD" -P -F '#{session_name}:#{window_id}')"
            tmux send-keys -t "$new_target" "task $task_id" C-m
            tmux switch-client -t "$new_target"
        fi
    else
        session="$(tmux display-message -p '#{client_last_session}')"
        target="$session:$window_name"
        if tmux has-session -t "$target" 2>/dev/null; then
            tmux attach-session -t "$target"
        elif tmux has-session -t "$session" 2>/dev/null; then
            new_target="$(tmux new-window -t "$session:" -n "$window_name" \
                -c "$PWD" -P -F '#{session_name}:#{window_id}')"
            tmux send-keys -t "$new_target" "task $task_id" C-m
            tmux attach-session -t "$new_target"
        else
            tmux new-session -A -s "$session" -n "$window_name" -c "$PWD"
            tmux send-keys -t "$session:$window_name" "task $task_id" C-m
        fi
    fi
    exit 0
fi

if [ "$1" = "--preview" ]; then
    case "$2" in
        __task_add_office__)
            printf '$ task add project:office "<TASK_DESC>"\n'
            exit 0
            ;;
        __task_office_*__)
            task_id="${2#__task_office_}"
            task_id="${task_id%__}"
            exec "$0" --task-preview "$task_id"
            ;;
    esac
    exec "$0" --preview-loop "$2"
fi

which tmux >/dev/null 2>&1 || { echo "tc: tmux not found" >&2; exit 1; }
which fzf  >/dev/null 2>&1 || { echo "tc: fzf not found"  >&2; exit 1; }

tmux info >/dev/null 2>&1 || { echo "tc: no tmux server running" >&2; exit 1; }

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

list_only=0
[ "$1" = "-l" ] && list_only=1

panes=$(tmux list-panes -a -F "#{pane_id}	#{session_name}:#{window_index}.#{pane_index}	#{window_name}	#{pane_pid}	#{pane_title}	#{pane_current_path}")
[ -z "$panes" ] && { echo "tc: no tmux panes found" >&2; exit 1; }

pane_pids=$(echo "$panes" | cut -f4 | tr '\n' ' ')

# Take a single ps snapshot and, for each pane's root pid, walk its process
# tree (via ppid) looking for a running `cursor-agent` or `waitingFor`
# process. Doing this as one awk pass (rather than N recursive pgrep/ps
# calls) is both faster and more reliable - pgrep -P has been observed to
# miss children in some sandboxed shells even though `ps` sees them fine.
# Emits semicolon-separated records with pipe-separated fields.
# A pane running both counts as waitingFor, since that is the process whose
# state and URLs the caller wants to see.
agent_pids=$(ps -axo pid=,ppid=,command= | awk -v ROOTS="$pane_pids" '
    BEGIN { n = split(ROOTS, roots, " ") }
    {
        pid = $1 + 0; ppid = $2 + 0
        $1 = ""; $2 = ""
        cmd = $0
        sub(/^ +/, "", cmd)
        command[pid] = cmd
        children[ppid] = children[ppid] " " pid
    }
    END {
        for (i = 1; i <= n; i++) {
            root = roots[i] + 0
            delete visited
            qlen = 1; queue[1] = root
            agent = 0; waiting = 0; waiting_details = ""
            while (qlen > 0) {
                cur = queue[qlen]; qlen--
                if (visited[cur]++) continue
                if (index(command[cur], "waitingFor") > 0) {
                    waiting = 1
                    waiting_details = command[cur]
                    sub(/^.*waitingFor[[:space:]]+/, "", waiting_details)
                    sub(/^--interval(=|[[:space:]]+)[0-9]+[[:space:]]*/, "", waiting_details)
                }
                else if (index(command[cur], "cursor-agent") > 0) agent = 1
                nkids = split(children[cur], kids, " ")
                for (k = 1; k <= nkids; k++) {
                    if (kids[k] != "") { qlen++; queue[qlen] = kids[k] }
                }
            }
            if (waiting) printf "%s|waitingFor|%s;", root, waiting_details
            else if (agent) printf "%s|cursor-agent||;", root
        }
    }
')

# pane_id \t kind \t "session:window.pane [window-name]" \t pane-title \t pane-path
matches=$(echo "$panes" | awk -F'\t' -v AGENTS="$agent_pids" '
    BEGIN {
        n = split(AGENTS, a, ";")
        for (i = 1; i <= n; i++) {
            split(a[i], fields, "[|]")
            kind[fields[1]] = fields[2]
            details[fields[1]] = fields[3]
        }
    }
    ($4 in kind) { printf "%s\t%s\t%s [%s]\t%s\t%s\t%s\n", $1, kind[$4], $2, $3, $5, $6, details[$4] }
')

for task_id in $(task project:office status:pending export | jq -r '.[].id'); do
    task_location="$(tmux list-panes -a -F '#{session_name}	#{window_name}	#{window_index}.#{pane_index}' |
        awk -F '\t' -v name="task-$task_id" '$2 == name { print $1 ":" $3; exit }')"
    [ -n "$task_location" ] || task_location="task-$task_id"
    task_description="$(task "$task_id" export | jq -r '.[0].description // ""' | tr '\t\n' '  ')"
    [ -n "$task_description" ] || task_description="task $task_id"
    matches="${matches}"$'\n'"__task_office_${task_id}__"$'\t'"task-project-office"$'\t'"$task_location"$'\t'"$task_description"$'\t'"$PWD"
done
matches="${matches}"$'\n'"__task_add_office__"$'\t'"task-add-office"$'\t'"task add project:office"$'\t'"Add new task"$'\t'"$PWD"

# Lead every row with "<icon> <state>". cursor-agent maintains its own state in
# the pane title as "<chat title> - <icon> <state>", so that just gets hoisted
# to the front. waitingFor polls silently, so the only reliable signal that it
# is done is the interactive prompt it prints after READY - the status file it
# also writes is a single global path, shared by every pane.
matches=$(
    while IFS=$'\t' read -r pane_id kind label title path waiting_details; do
        icon="🤖" state="running"
        if [ "$kind" = "waitingFor" ]; then
            [ -n "$waiting_details" ] && title="$waiting_details"
            if tmux capture-pane -p -t "$pane_id" 2>/dev/null |
                tail -n 5 |
                grep -q 'Further prompt (Enter to exit)'; then
                icon="✅" state="ready"
            else
                icon="⏳" state="waiting"
            fi
        elif [ "$kind" = "task-project-office" ]; then
            icon="📋" state="office"
        elif [ "$kind" = "task-add-office" ]; then
            icon="➕" state="add"
        elif [ "$title" != "${title% - *}" ]; then
            suffix="${title##* - }"
            title="${title% - *}"
            icon="${suffix%% *}"
            # The title's state is animated ("Working ···"), so trim the
            # trailing dots to stop rows jittering between refreshes.
            state=$(printf '%s' "${suffix#* }" |
                sed -E 's/[[:space:]]*[.·•…]+[[:space:]]*$//' |
                tr '[:upper:]' '[:lower:]')
            if [ -z "$state" ] || [ "$state" = "$icon" ]; then
                state="running"
            fi
        fi
        printf '%s\t%s %-8s %s\t%s\t%s\n' \
            "$pane_id" "$icon" "$state" "$label" "$title" "$path"
    done <<<"$matches"
)

if [ "$list_only" = "1" ]; then
    echo "$matches" | cut -f2-
    exit 0
fi

selected=$(echo "$matches" | fzf \
    --delimiter=$'\t' \
    --with-nth=2,3 \
    --reverse \
    --header="cursor-agent / waitingFor / task project:office tasks >" \
    --preview "\"$self\" --preview {1}" \
    --bind "alt-o:execute-silent(\"$self\" --open-entry {1} {3})" \
    --preview-window=bottom:60%)

[ -z "$selected" ] && exit 1

pane_id=$(echo "$selected" | cut -f1)

case "$pane_id" in
    __task_add_office__)
        exec "$self" --add-task-office
        ;;
    __task_office_*__)
        task_id="${pane_id#__task_office_}"
        task_id="${task_id%__}"
        exec "$self" --open-task-pane "$task_id"
        ;;
esac

if [ -z "$TMUX" ]; then
    tmux attach-session -t "$pane_id"
else
    tmux switch-client -t "$pane_id"
    tmux select-window -t "$pane_id"
    tmux select-pane -t "$pane_id"
fi
